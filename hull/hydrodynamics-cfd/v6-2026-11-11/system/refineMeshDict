FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      refineMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

coordinates
{
    type        global;

    e1          (1 0 0);
    e2          (0 1 0);

    directions  (e1 e2);
}

zones
{
    level1
    {
        type    box;
        box     (-5 -3 -2.5) (5 0 2.5);
    }

    level2
    {
        type    box;
        box     (-4 -2 -1.5) (4.5 0 1.8);
    }

    level3
    {
        type    box;
        box     (-3 -1 -0.7) (3.6 0 1.0);
    }

    level4
    {
        type    box;
        box     (-2.2 -0.7 -0.45) (3.0 0 0.6);
    }

    level5
    {
        type    box;
        box     (-1.2 -0.5 -0.25) (2.6 0 0.45);
    }

    level6
    {
        type    box;
        box     (-0.8 -0.42 -0.15) (2.3 0 0.4);
    }

    level7
    {
        type    box;
        box     (-0.25 -0.32 -0.1) (2.05 0 0.35);
    }

}

