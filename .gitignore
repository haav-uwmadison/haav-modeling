# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# root package.json only delegates into dashboard/ - no real deps to lock
/node_modules
/pnpm-lock.yaml

# misc
.DS_Store
*.pem

# env files (can opt-in for committing if needed)
.env*

# gstack
.gstack/

# universal agent-skills mirror; .claude/skills/ is the committed copy
/.agents/

# CAD: the Python env and everything agentcad generates. Source lives in
# cad/hull.py; rebuild with `agentcad run hull.py` (see README).
/.venv-cad/
/hull/geometry/legacy-parametric/build/

# OpenFOAM decomposed solver output (hundreds of MB); regenerate with the case run scripts
hull/hydrodynamics-cfd/**/processor*/

.venv/
__pycache__/
.pytest_cache/
runs/
.ipynb_checkpoints/
.mpl-cache/

# Isolated hydrostatics dependency environment
/hull/hydrostatics/.venv/

# CFD: only the lightweight v6 case setup, scripts, notebook and summary results are
# published. Heavy solver output (animation surfaces ~1 GB, solver log, 3D fields) stays
# local/on the server; regenerate with sync_results.sh. v4 and legacy CFD stay local.
/hull/hydrodynamics-cfd/*
!/hull/hydrodynamics-cfd/README.md
!/hull/hydrodynamics-cfd/v6-2026-11-11/
/hull/hydrodynamics-cfd/v6-2026-11-11/results-ramp20/postProcessing/animation/
/hull/hydrodynamics-cfd/v6-2026-11-11/results-ramp20/animation/
/hull/hydrodynamics-cfd/v6-2026-11-11/results-ramp20/case/
/hull/hydrodynamics-cfd/v6-2026-11-11/results-ramp20/log.foamRun
/hull/hydrodynamics-cfd/v6-2026-11-11/results-ramp20/view-*.html
